# ==============================================================================
#  نظام المعلومات المدنية الشامل — نموذج متغيّرات البيئة
# ==============================================================================
#  انسخ هذا الملف باسم .env ثم عدّل القيم:
#      cp .env.example .env
#
#  ⚠️  لا تضع ملف .env في نظام إدارة الإصدارات (Git) أبداً.
# ==============================================================================

# --- عام ---
APP_NAME=نظام المعلومات المدنية الشامل
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- قاعدة البيانات ---
# للتطوير المحلي (SQLite):
DATABASE_URL=sqlite:///./civil_dev.db
# للإنتاج (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://civil_user:CHANGE_ME@localhost:5432/civil_db
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- الأمان ---
# ولّد مفتاحاً عشوائياً بالأمر:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-A-LONG-RANDOM-STRING

# مفتاح تشفير الحقول الحسّاسة داخل قاعدة البيانات، يُولَّد بالأمر:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

PASSWORD_MIN_LENGTH=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=20

# --- تحديد معدّل الطلبات ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- الشبكة ---
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["*"]
FORCE_HTTPS=false                # فعّله في الإنتاج

# --- الملفات المرفوعة ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- التوطين ---
DEFAULT_LOCALE=ar
TIMEZONE=Asia/Baghdad
DEFAULT_NUMERALS=latin           # latin | arabic

# --- النسخ الاحتياطي ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# --- إعدادات حاوية PostgreSQL (تُستخدم في docker-compose) ---
POSTGRES_USER=civil_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=civil_db
POSTGRES_PORT=5432
