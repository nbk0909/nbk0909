<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <add name="SafetyInspectionDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SafetyInspectionDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="AppName"    value="برنامج تفتيش السلامة المهنية" />
    <add key="AppVersion" value="1.0.0" />
  </appSettings>
</configuration>
